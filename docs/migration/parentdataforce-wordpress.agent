name: Parent Data Force WordPress Manager
description: A skill for managing the Parent Data Force WordPress site, including theme management, content migration, and site administration.

instructions: |
  This skill helps manage the Parent Data Force WordPress site through the REST API and custom tooling.
  
  ## Capabilities
  - Theme management (upload, update, verify)
  - Content creation and migration via REST API
  - Site health monitoring
  - Custom post type management
  - Backup operations
  
  ## Usage Examples
  - "Upload the latest theme updates to WordPress"
  - "Create a new article about school district accountability"
  - "Check the health of the WordPress site"
  - "Migrate content from the static site"
  - "Backup the current WordPress configuration"
  
  ## Key Commands
  - Deploy theme: `cd tools && python deploy_theme.py` (upload + activate + verify)
  - Verify only: `cd tools && python deploy_theme.py --verify` (writes nothing)
  - Create content: `cd rest && python wp.py new-post --title T --content HTML --status draft`
  - Publish articles: `cd tools && python publish_articles.py --verify`
  - Site health: `cd rest && python wp.py whoami` then GET /news/ and check body class

# Current tooling reads credentials from rest/credentials.json (gitignored), NOT from
# environment variables. The names below are legacy: only docs/migration/wp_config.py
# and the scripts that import it still reference them.
environment_variables:
  - WP_USERNAME          # legacy (docs/migration only)
  - WP_APPLICATION_PASSWORD  # legacy (docs/migration only)
  - WP_API_URL           # legacy (docs/migration only)

files:
  - path: rest/wp.py
    description: WordPress REST API client (run from rest/)
  - path: tools/deploy_theme.py
    description: Theme deployment + permalink fix + verification
  - path: tools/md_to_blocks.py
    description: Markdown to Gutenberg block HTML converter
  - path: tools/publish_articles.py
    description: Create article drafts via REST
  - path: tools/wp_api.py
    description: Thin REST client reused by tools/
  - path: AGENTS.md
    description: Authoritative repo guidelines for AI assistants

configuration:
  model: default
  temperature: 0.7